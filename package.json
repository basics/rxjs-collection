{
  "name": "rxjs-collection",
  "version": "0.0.0",
  "description": "collection of rxjs helpers",
  "license": "MIT",
  "private": true,
  "contributors": [
    {
      "name": "Stephan Gerbeth",
      "email": "stephan.gerbeth@gmail.com"
    }
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basics/rxjs-collection.git"
  },
  "files": [
    "packages/operators/dist",
    "packages/operators/node-modules",
    "packages/operators/package.json",
    "packages/observables/dist",
    "packages/observables/node-modules",
    "packages/observables/package.json"
  ],
  "scripts": {
    "postinstall": "npm run build:packages",
    "build": "npm run build:packages",
    "build:packages": "npm run build --workspaces --if-present",
    "lint": "npm run lint:es",
    "lint:es": "eslint --flag unstable_native_nodejs_ts_config .",
    "prepare": "husky",
    "release": "npm run release --workspaces",
    "release:proof": "npx dotenv-cli -- npm run release -- -- --dry-run",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:project:observables": "vitest --project packages/observables",
    "test:project:operators": "vitest --project packages/operators",
    "test:project:playground": "vitest --project packages/playground",
    "coverage": "vitest run --coverage"
  },
  "exports": {
    "./observables": {
      "import": "./packages/observables/dist/index.mjs",
      "require": "./packages/observables/dist/index.cjs",
      "types": "./packages/observables/dist/index.d.ts"
    },
    "./operators": {
      "import": "./packages/operators/dist/index.mjs",
      "require": "./packages/operators/dist/index.cjs",
      "types": "./packages/operators/dist/index.d.ts"
    }
  },
  "workspaces": [
    "packages/mocks",
    "packages/operators",
    "packages/observables",
    "packages/playground"
  ],
  "devDependencies": {
    "@commitlint/config-conventional": "20.0.0",
    "@eslint/js": "9.35.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.6",
    "@semantic-release/npm": "12.0.2",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@types/eslint-plugin-security": "3.0.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/eslint-plugin": "1.3.12",
    "@vitest/ui": "3.2.4",
    "commitlint": "20.0.0",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-no-secrets": "2.2.1",
    "eslint-plugin-perfectionist": "4.15.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-security": "3.0.1",
    "fetch-mock": "12.5.4",
    "globals": "16.4.0",
    "happy-dom": "18.0.1",
    "husky": "9.1.7",
    "lint-staged": "16.1.6",
    "prettier": "3.6.2",
    "semantic-release": "24.2.8",
    "semantic-release-monorepo": "8.0.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0",
    "undici": "7.16.0",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@rollup/plugin-typescript": "12.1.4",
    "tslib": "2.8.1",
    "unbuild": "3.6.1",
    "unplugin-replace": "0.6.1"
  }
}